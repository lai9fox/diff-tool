---
import Workbench from '../components/Workbench.vue';
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="在浏览器本地比较代码、配置与文字。Compare text, locally."
    />
    <meta name="theme-color" content="#F5F7FA" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.site} />
    <title>Diff — 文本差异对比</title>
    <script is:inline>
      let savedTheme;
      try {
        savedTheme = JSON.parse(
          localStorage.getItem('diff.preferences') || '{}',
        )?.theme;
      } catch {}
      const dark =
        savedTheme === 'dark' ||
        (savedTheme !== 'light' &&
          matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      document
        .querySelector('meta[name="theme-color"]')
        .setAttribute('content', dark ? '#171b22' : '#f5f7fa');
    </script>
  </head>
  <body>
    <Workbench client:only="vue" />
    <noscript>
      Diff 需要启用 JavaScript 才能在本机比较文本。JavaScript is required to
      compare text locally.
    </noscript>
  </body>
</html>
